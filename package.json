{
  "name": "dental-lab-manager",
  "version": "1.0.0",
  "description": "نظام إدارة معمل الأسنان",
  "main": "./out/main/index.js",
  "author": "Dental Lab Manager",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall2": "electron-builder install-app-deps",
    "build:win": "npm run build; electron-builder --win --config electron-builder.yml",
    "build:unpack": "npm run build; electron-builder --win --dir --config electron-builder.yml",
    "license:generate": "node scripts/generate-license.mjs"
  },
  "dependencies": {
    "realm": "^20.2.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "com.dental-lab.manager",
    "productName": "Dental Lab Manager",
    "directories": {
      "buildResources": "resources"
    },
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
